OPENAI_API_KEY=sk-proj-...
AEGIS_MVP_PROJECT_ROOT=/Users/your-name/projects/Aegis-MVP
PTFRIENDS_PROJECT_ROOT=/Users/your-name/projects/ptfriendsapp
SOOLSOOL_PROJECT_ROOT=/Users/your-name/projects/soolsool
SOL_SERVER_PROJECT_ROOT=/srv/sol-server
MAC_AGENT_TOKEN=replace-with-a-long-random-local-token
MAC_AGENT_ALLOWED_APPS=Visual Studio Code,Finder,Google Chrome
# 모든 앱 허용(앱 실행 전 음성 승인은 계속 필요): MAC_AGENT_ALLOWED_APPS=*
MAC_AGENT_URL=http://127.0.0.1:4318
SERVER_AGENT_TOKEN=replace-with-a-different-long-random-token
SERVER_AGENT_URL=http://sol-server:4319
SERVER_AGENT_HOST=127.0.0.1
SERVER_AGENT_PORT=4319
AEGIS_OLLAMA_URL=http://<TAILSCALE_IP>:11434
AEGIS_VISION_OLLAMA_URL=http://<TAILSCALE_IP>:11434
OLLAMA_MODEL=qwen2.5vl:3b
AEGIS_VISION_MODEL=qwen2.5vl:3b
AEGIS_VISION_LOCAL_FALLBACK=false
AEGIS_OLLAMA_REMOTE_TIMEOUT_SECONDS=300
AEGIS_VISION_REMOTE_TIMEOUT_SECONDS=300
AEGIS_CODING_TASK_TIMEOUT_SECONDS=900
AEGIS_CODING_MAX_CHANGED_FILES=20
# Projects whose typecheck/lint/test/build scripts run without approval (comma-separated).
AEGIS_AUTO_VALIDATION_PROJECTS=
AEGIS_AUTONOMOUS_MAX_CHANGED_FILES=5
AEGIS_AUTONOMOUS_MAX_TASKS_PER_REQUEST=1
AEGIS_AUTONOMOUS_REPAIR_ATTEMPTS=1
AEGIS_CODING_AGENT_PROVIDER=codex
AEGIS_CODING_AGENT_FALLBACK=none
AEGIS_REMOTE_ENABLED=false
# Keeps the Mac from idle-sleeping while AegisDesktop runs; defaults to AEGIS_REMOTE_ENABLED.
AEGIS_REMOTE_KEEP_AWAKE=
# Enable only with a loopback, private, or Tailscale address. Never use 0.0.0.0.
AEGIS_REMOTE_HOST=127.0.0.1
AEGIS_REMOTE_PORT=8790
AEGIS_REMOTE_TOKEN=replace-with-at-least-32-random-characters
AEGIS_REMOTE_MAX_COMMAND_CHARS=4000
AEGIS_REMOTE_APPROVAL_TTL_SECONDS=300
AEGIS_REMOTE_SESSION_TTL_SECONDS=3600
AEGIS_REMOTE_RATE_LIMIT_PER_MINUTE=30
AEGIS_REMOTE_REGISTRATION_RATE_LIMIT_PER_MINUTE=5
# Stores only salted hashes of revocable device credentials. Never put master tokens here.
AEGIS_REMOTE_DEVICE_STORE_PATH=
AEGIS_DESKTOP_COMMAND_URL=http://127.0.0.1:8791
AEGIS_DESKTOP_BRIDGE_HOST=127.0.0.1
AEGIS_DESKTOP_BRIDGE_PORT=8791
AEGIS_DESKTOP_BRIDGE_TOKEN=replace-with-a-different-32-character-random-secret
